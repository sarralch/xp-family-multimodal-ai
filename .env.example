# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Non-secret tunables (models, top_k, chunk size...) live in configs/default.env.

# --- Required for answers (the ingredient safety check works without it) ---
GEMINI_API_KEY=

# --- Django UI ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Optional ---
# Only needed outside Docker when Tesseract is not on PATH, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Point at your local datasets (see data/README.md); defaults to ./data
# DATA_DIR=data
