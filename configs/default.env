# Non-secret defaults, committed. Loaded before .env, so .env (or real environment
# variables) override anything here. Secrets never go in this file.

# LLM
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
USE_RERANKER=true
CANDIDATES_K=20
TOP_K=4
RRF_K=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Paths
DATA_DIR=data
CACHE_DIR=.cache

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
